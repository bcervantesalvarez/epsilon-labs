---
import BaseLayout from '@layouts/BaseLayout.astro';
import KatexAssets from '@components/KatexAssets.astro';
const bodies = import.meta.glob('../../../content/presentation-readers/*.html', { eager: true, query: '?raw', import: 'default' });
const decks = [
  ['BuildAQuartoPortfolio', 'Building a Professional Portfolio with Quarto and GitHub Pages', '/talks/building-professional-portfolio-via-quarto'],
  ['LoanApproval', 'Loan Approval Logistic Regression Analysis', '/talks/loan-application-statistical-analysis'],
  ['MissingData', 'Exploring Missing Data & M.I.C.E.', '/talks/missing-data-with-mice-statistical-analysis'],
  ['WebR', 'Hands-on Teaching with webR', '/talks/teaching-with-webr'],
  ['TeachingQuarto', 'Quarto 101', '/talks/understanding-quarto'],
  ['water-parasites', 'Climate Change is Changing Host-Parasite Relationships', '/talks/water-parasites-survival-analysis'],
];
export function getStaticPaths() {
  return ['BuildAQuartoPortfolio', 'LoanApproval', 'MissingData', 'WebR', 'TeachingQuarto', 'water-parasites'].map(deck => ({ params: { deck } }));
}
const deck = decks.find(d => d[0] === Astro.params.deck)!;
const body = bodies[`../../../content/presentation-readers/${deck[0]}.html`] as string;
---
<BaseLayout title={`${deck[1]} · Reading view`}>
  <KatexAssets slot="head" />
  <main class="max-w-prose mx-auto px-6 pt-24 pb-16">
    <a href={deck[2]}>← Back to presentation</a>
    <h1 class="font-serif text-4xl text-ink mt-8 mb-5">{deck[1]}</h1>
    <p class="text-muted">Reading view preserves the published slide content in a scrolling layout. Open the presentation for interactive examples and animated fragments.</p>
    <div class="article-body deck-reader" set:html={body}></div>
    <p class="text-xs text-muted mt-12">AI assistance: Codex adapted the original authors’ slide content for responsive reading. Model/version: unknown (metadata unavailable). Reasoning effort: unknown (metadata unavailable). No human signoff recorded.</p>
  </main>
</BaseLayout>
