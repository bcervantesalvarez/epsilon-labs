---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { visibleContent } from '@lib/content-visibility';
import BaseLayout from '@layouts/BaseLayout.astro';
import BackLink from '@components/BackLink.astro';
import LegacyCharts from '@components/LegacyCharts.astro';
import KatexAssets from '@components/KatexAssets.astro';
import ReadingContent from '@components/ReadingContent.astro';

export async function getStaticPaths() {
  const entries = await getCollection('blog', visibleContent);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'blog'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) => d.toLocaleDateString('en-US',
  { timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric' });
const backHref = '/blog';
const backLabel = 'All posts';
---
<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogPath={`blog/${entry.id}`}
>
  {entry.data.draft && <meta slot="head" name="robots" content="noindex,nofollow" />}
  {/* KaTeX only ships on article routes — ported bodies may carry math */}
  <KatexAssets slot="head" />
  <article class="reading-page max-w-[960px] mx-auto px-6 pt-20 pb-16">
    <header class="max-w-prose mx-auto mb-12">
    {entry.data.draft && <p class="draft-note">Review draft · September 5, 2026 · Not published</p>}
    <BackLink href={backHref} label={backLabel} />
    <p class="text-sm text-muted m-0 mb-3">{fmt(entry.data.date)}</p>
    <h1
      class="font-serif font-semibold text-ink text-5xl md:text-6xl tracking-tight leading-[1.06] m-0 mb-5"
      transition:name={`post-title-${entry.id}`}
    >
      {entry.data.title}
    </h1>
    <p class="text-lede text-body m-0 mb-10">{entry.data.description}</p>
    </header>
    <ReadingContent>
      <Content />
    </ReadingContent>
    <nav aria-label="Continue reading" class="reading-next max-w-prose mx-auto mt-16 border-t border-rule pt-8 flex flex-wrap justify-between gap-6">
      <a href={backHref} class="text-accent font-semibold">← {backLabel}</a>
      <a href="/projects" class="text-accent font-semibold">Explore the projects →</a>
    </nav>
  </article>
  <LegacyCharts />
</BaseLayout>
