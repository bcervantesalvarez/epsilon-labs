---
interface Props {
  school: string;
  degree: string;
  degreeTone: "copper" | "navy" | "plum";
  years: string;
  href: string;
  hrefLabel?: string;
  color: string;
  accent: string;
  align?: 'left' | 'right';
  description: string;
  logoSrc?: string;
  logoAlt?: string;
  logoDarkSrc?: string;
}
const { school, degree, degreeTone, years, href, hrefLabel = 'Visit department', color, description, logoSrc, logoDarkSrc, logoAlt = school } = Astro.props;
---
<article class="school-showcase" data-degree-tone={degreeTone} style={`--school-color: ${color}`}>
  <a class="school-stage" href={href} target="_blank" rel="noreferrer" aria-label={`${school}: ${hrefLabel}`}>
    <span class="stage-layer stage-back" aria-hidden="true"></span>
    <span class="stage-layer stage-middle" aria-hidden="true"></span>
    <div class="stage-image school-logo-plane">
      {logoSrc && <div class:list={["school-logo", { "school-logo-linfield": logoSrc.includes("linfield") }]}>
        {logoSrc.includes('linfield') ? <>
          <svg viewBox="74 71 139 146" role="img" aria-label={logoAlt} class="dark:hidden"><image href={logoSrc} width="288" height="288" /></svg>
          <svg viewBox="74 71 139 146" role="img" aria-label={logoAlt} class="hidden dark:block"><image href={logoDarkSrc || logoSrc} width="288" height="288" /></svg>
        </> : <>
          <img src={logoSrc} alt={logoAlt} loading="lazy" decoding="async" width="320" height="160" class={logoDarkSrc ? "dark:hidden" : ""} />
          {logoDarkSrc && <img src={logoDarkSrc} alt={logoAlt} loading="lazy" decoding="async" width="320" height="160" class="hidden dark:block" />}
        </>}
      </div>}
    </div>
  </a>
  <div class="showcase-copy school-copy">
    <h3 class="degree-title">{degree}</h3>
    <p class="school-name">{school}</p>
    <p class="school-years">{years}</p>
    <p>{description}</p>
    <div class="showcase-actions"><a href={href} target="_blank" rel="noreferrer">{hrefLabel} <span aria-hidden="true">↗</span></a></div>
  </div>
</article>
