---
import 'katex/dist/katex.min.css';
---
<script>
  import katex from 'katex';
  import renderMathInElement from 'katex/contrib/auto-render';
  function renderArticleMath() {
    document.querySelectorAll<HTMLElement>('.article-body .math:not([data-katex-rendered])').forEach(element => {
      let tex = (element.textContent || '').trim();
      tex = tex.replace(/^\\[([]|\\[)\]]$/g, '').replace(/^\$\$|\$\$$/g, '');
      // Percent values in the imported math spans mean literal percentages.
      tex = tex.replace(/(?<!\\)%/g, '\\%');
      katex.render(tex, element, { throwOnError: false, displayMode: element.classList.contains('display'), strict: 'ignore' });
      element.dataset.katexRendered = '';
    });
    document.querySelectorAll<HTMLElement>('.article-body').forEach(element => renderMathInElement(element, {
      delimiters: [{left: '$$', right: '$$', display: true}, {left: '\\[', right: '\\]', display: true}, {left: '\\(', right: '\\)', display: false}],
      ignoredClasses: ['math', 'katex'], throwOnError: false, strict: 'ignore'
    }));
  }
  document.addEventListener('astro:page-load', renderArticleMath);
  if (document.readyState !== 'loading') renderArticleMath();
  else document.addEventListener('DOMContentLoaded', renderArticleMath);
</script>
