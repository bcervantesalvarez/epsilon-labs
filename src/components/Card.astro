---
// src/components/Card.astro
// Clickable project/post card. 1px border at rest, border darkens on hover,
// image zooms slightly. No drop-shadow.
interface Props {
  href: string;
  title: string;
  description?: string;
  tag?: string;
  image?: string;
  imageAlt?: string;
  external?: boolean;
}

const { href, title, description, tag, image, imageAlt = '', external } = Astro.props;
const target = external ? '_blank' : undefined;
const rel = external ? 'noreferrer' : undefined;
---
<a
  href={href}
  target={target}
  rel={rel}
  class="project-card group flex flex-col h-full bg-surface border border-rule overflow-hidden no-underline hover:border-ink"
>
  {image && (
    <div class="project-art">
      <img
        src={image}
        srcset={image.includes("/images/projects/") ? `${image.replace("-1280", "-640")} 640w, ${image} 1280w` : undefined}
        sizes="(max-width: 640px) 100vw, 40vw"
        alt={imageAlt}
        loading="lazy"
        class="project-image"
      />
    </div>
  )}
  <div class="project-copy flex-1 px-6 pt-5 pb-7">
    {tag && (
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.12em] text-accent-ink m-0 mb-2">
        {tag}
      </p>
    )}
    <h3 class="font-serif font-semibold text-ink text-2xl leading-snug mt-0 mb-2">
      {title}
    </h3>
    {description && (
      <p class="text-sm text-muted leading-relaxed m-0">
        {description}
      </p>
    )}
    <span class="project-action">{external ? "Open dashboard" : "Explore project"} <span aria-hidden="true">↗</span></span>
  </div>
</a>
