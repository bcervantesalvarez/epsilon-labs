---
import TopicMark from "@components/TopicMark.astro";
interface Props {
  href: string;
  title: string;
  tag: string;
  description: string;
  image?: string;
}
const { href, title, tag, description, image } = Astro.props;
const topic = title.includes("Statistical Learning") ? "learning" : title.includes("Statistics") ? "statistics" : title.includes("World") ? "world" : tag === "Book" ? "publishing" : "data";
---
<a href={href} target="_blank" rel="noreferrer" class="resource-card">
  <span class="resource-icon" aria-hidden="true">{image ? <img src={image} alt="" width="64" height="64" loading="lazy" /> : <TopicMark topic={topic} />}</span>
  <div class="resource-copy"><span class="resource-tag">{tag}</span><h3>{title}</h3><p>{description}</p></div>
  <span class="resource-arrow" aria-hidden="true">↗</span>
</a>
